#!/usr/bin/env sh
# omatodolist — drive the omatodolist plugin through its IPC channel.
#
# Usage: omatodolist <method> [args...]
# Methods: open close show hide toggle ping addNote addTodo listNotes
#          listTodos toggleTodo remove clearHistory  (see SKILL.md)
set -eu

OMARCHY_SHELL="${OMARCHY_SHELL:-/usr/share/omarchy/shell}"

# Discover the running omarchy shell's quickshell instance. The pattern is
# anchored so it cannot match this script's own process (whose command line
# contains the same string).
qspid="$(pgrep -f "^quickshell -n -p $OMARCHY_SHELL\$" | head -1 || true)"
if [ -z "$qspid" ]; then
  echo "omatodolist: no running omarchy shell (start it, or set OMARCHY_SHELL)" >&2
  exit 1
fi

qs ipc --pid "$qspid" call scratchpad "$@"
code=$?

# Mutations ack before the sqlite write lands (spec §4); give the file watcher a
# beat so an immediately-following listNotes/listTodos is already converged.
case "${1:-}" in
  addNote|addTodo|toggleTodo|remove|clearHistory) sleep 0.4 ;;
esac

exit $code